startup --host_jvm_args=-Xmx2048m
common --enable_bzlmod
build --jobs=2
build --local_resources=memory=2048
build --spawn_strategy=processwrapper-sandbox
build --incompatible_strict_action_env
build --action_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
build --host_action_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
build --repository_cache=/state/repository-cache
build --remote_timeout=120
build --remote_download_outputs=all
build --remote_max_connections=8
build --remote_upload_local_results=false
build --test_output=errors
build --verbose_failures
build:release --compilation_mode=opt
build:release --copt=-O2
build:debug --compilation_mode=dbg
build:debug --copt=-O0
test --cache_test_results=no
try-import %workspace%/.bazelrc.local
build:stats --define=stats=1
