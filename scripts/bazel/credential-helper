#!/usr/bin/env python3
"""Bazel credential-helper protocol. Never emit credentials to stderr."""

import base64
import json
from pathlib import Path
import re
import sys
from urllib.parse import urlsplit


def main():
    # Bazel leaves stdin open while waiting for the response.
    payload = ""
    for line in sys.stdin:
        payload += line
        try:
            request = json.loads(payload)
        except json.JSONDecodeError:
            continue
        break
    else:
        sys.exit("Missing or invalid credential request")
    try:
        uri = urlsplit(request["uri"])
        if (uri.scheme != "https" or uri.hostname != "bazel-cache.wallintech.eu"
                or uri.port not in (None, 443) or uri.username is not None
                or uri.password is not None):
            sys.exit("Unexpected cache origin")
    except (KeyError, TypeError, ValueError):
        sys.exit("Invalid cache URI")

    text = Path("/run/bazel-cache-credential").read_bytes().decode().strip()
    # credentials.py provisions curl config files; CI may supply a bare pair.
    match = re.fullmatch(r'user\s*=\s*"([^"\\\r\n]+)"', text)
    credential = match.group(1) if match else text
    account, separator, password = credential.partition(":")
    if (not separator or not password or re.search(r"\s", password)
            or not re.fullmatch(r"(?:reader|writer)-[a-z0-9]+(?:-[a-z0-9]+)*", account)):
        sys.exit("Invalid personal cache credential format")
    json.dump({"headers": {"Authorization": ["Basic " + base64.b64encode(credential.encode()).decode()]}}, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
