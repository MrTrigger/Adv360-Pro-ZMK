#!/usr/bin/env python3
"""Bazel credential-helper protocol. Never emit credentials to stderr."""

import base64
import json
from pathlib import Path
import sys
from urllib.parse import urlparse

# Decode one request without waiting for the client to close its input pipe.
payload = ""
for line in sys.stdin:
    payload += line
    try:
        request = json.loads(payload)
    except json.JSONDecodeError:
        continue
    break
else:
    sys.exit("Missing or invalid credential request")
if urlparse(request["uri"]).hostname != "bazel-cache.wallintech.eu":
    sys.exit("Unexpected cache hostname")
credential = Path("/run/bazel-cache-credential").read_bytes().strip()
json.dump({"headers": {"Authorization": ["Basic " + base64.b64encode(credential).decode()]}}, sys.stdout)
